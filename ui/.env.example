# Copy to .env.local and adjust. Vite exposes only VITE_-prefixed variables.

# Base URL of the inference API. Leave unset in development to use the Vite
# proxy configured in vite.config.js (which forwards /api to the backend).
# Set it when the dashboard is served from a different origin than the API.
# VITE_API_URL=https://api.example.com
